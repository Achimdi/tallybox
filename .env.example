# Copy this file to `.env.local` (same folder) and fill in the values.
# `.env.local` is gitignored. Never commit real values, and never paste keys into chat.
#
# Only variables starting with VITE_ are exposed to the browser. That is safe for
# the two below: they are public by design, and data is protected by Row Level
# Security and server functions, not by hiding these values.
#
# NEVER put the Supabase secret key (sb_secret_... or the legacy service_role key)
# in this file. It belongs only in Edge Function secrets.

# Supabase dashboard > Project Settings > API (use the tallybox-dev project locally)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase dashboard > Project Settings > API Keys > Publishable key (sb_publishable_...)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare dashboard > Turnstile > site key (public). Needed from Phase 1.
VITE_TURNSTILE_SITE_KEY=
