# Settings for Edge Functions.
#
# Local use (`npx supabase functions serve`): copy to `supabase/functions/.env`
# (gitignored) and fill in.
# Hosted projects: set the same names with `npx supabase secrets set NAME=value`
# or in the dashboard under Edge Functions > Secrets. Never commit real values.

# Cloudflare Turnstile SECRET key (dashboard > Turnstile > your widget).
# For local testing, Cloudflare's always-pass test secret is:
#   1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# The app's own addresses, comma separated. A * matches one subdomain label,
# which covers Cloudflare preview deploys. If unset, only localhost is allowed.
#   https://tallybox.pages.dev,https://*.tallybox.pages.dev
APP_ORIGINS=

# Domain used to build staff sign-in addresses. Leave unset to use the default
# (tallybox.invalid). Must match VITE_STAFF_EMAIL_DOMAIN in the web app.
# STAFF_EMAIL_DOMAIN=
