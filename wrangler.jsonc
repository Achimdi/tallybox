// Cloudflare Workers settings for the Tallybox website.
//
// Cloudflare builds this repository on every push to main (Workers Builds:
// `npm run build`, then `npx wrangler deploy`) and publishes the finished app
// from web/dist. There is no Worker code: only the app's files are served,
// and requests to static files are free and unlimited.
//
// "single-page-application": any address that isn't a file (/owner/dashboard,
// /reset-password?token=...) gets index.html, and the app's router takes over.
{
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "tallybox",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./web/dist",
    "not_found_handling": "single-page-application",
  },
}
